# ==============================================================================
# FileMate — Backend Environment Configuration Template
# Copy this file to `backend/.env` and configure credentials for your environment.
# ==============================================================================

# Application Metadata
APP_NAME=FileMate
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Database Configuration (SQLite path)
# Default points to db/brightpath_vault.db relative to workspace root
DATABASE_URL=sqlite:///../db/brightpath_vault.db

# Authentication & Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_SECRET_KEY=change-this-to-a-secure-jwt-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Provider Configuration ("azure_openai" or "openai")
LLM_PROVIDER=azure_openai

# Azure OpenAI Credentials (Primary LLM Provider)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini

# OpenAI Direct Credentials (Fallback LLM Provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# Agent Execution & HITL Safety Thresholds
LLM_TIMEOUT_SECONDS=45
MAX_INPUT_LENGTH=2000
PENDING_ACTION_EXPIRY_MINUTES=10

# Network & CORS Settings
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8001
