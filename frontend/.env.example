# ==============================================================================
# FileMate — Frontend Environment Configuration Template
# Copy this file to `frontend/.env` and configure for your environment.
# ==============================================================================

# Backend API Base URL
# Leave empty in local development to use Vite's internal proxy forwarder (/api -> http://localhost:8001).
# In production or standalone deployments, set the full API host (e.g., http://localhost:8001 or https://api.yourdomain.com).
VITE_API_BASE_URL=
